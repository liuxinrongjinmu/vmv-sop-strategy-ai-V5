# Security (required for production)
# Set X-API-Key header in requests
API_KEY=your_api_key_here

# LLM API Keys
ZHIPU_API_KEY=your_zhipu_api_key_here
QWEN_API_KEY=your_qwen_api_key_here

# Search API Key
TAVILY_API_KEY=your_tavily_api_key_here

# Model Provider
LLM_PRIMARY_PROVIDER=zhipu
LLM_FALLBACK_PROVIDER=qwen

# Database
# SQLite for development (default)
DATABASE_URL=sqlite+aiosqlite:///./data/vmv_sop.db
# PostgreSQL for production
# DATABASE_URL=postgresql+asyncpg://vmv_user:password@localhost:5432/vmv_sop

# Server Config
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# CORS (comma-separated origins)
# Dev: CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Prod: CORS_ORIGINS=https://your-frontend.vercel.app
CORS_ORIGINS=

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_REPORT_PER_MINUTE=5
